# Generated. The code is deterministic -- no randomness in the integration,
# the partial phases, or the rasteriser -- so every run reproduces these
# byte for byte. Committing them would just be a second copy.
state/
# the 1080p60 crf16 master, ~133 MB. tsingou-1080p.mp4 is the committed one.
# (no trailing comments here -- gitignore treats them as part of the pattern)
tsingou.mp4
*.wav
*.f32
__pycache__/
